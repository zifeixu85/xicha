# Public browser endpoints — copy these from your Neon project console.
# Production builds default to the cost-safe classroom demo mode. In local
# `npm run dev` it defaults to false. Only set false in a controlled production
# deployment where you intentionally want to enable paid media generation.
VITE_PUBLIC_DEMO_MODE=

VITE_NEON_AUTH_URL=https://your-project.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://your-project.apirest.region.aws.neon.tech/neondb/rest/v1

# Server-side copy of the same public Neon Auth URL. Used to verify JWTs via JWKS.
# The server falls back to VITE_NEON_AUTH_URL locally, but set this explicitly in production.
NEON_AUTH_URL=https://your-project.neonauth.region.aws.neon.tech/neondb/auth

# Server-side only. Used by migrations and the authenticated creation library;
# never expose this with VITE_.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require

# Server-side only. Used to generate a unique blessing after each random pick.
# Never prefix this variable with VITE_ or expose it in browser code.
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Server-side only. Used for on-demand MiniMax speech synthesis.
# Never prefix this variable with VITE_ or expose it in browser code.
MINIMAX_API_KEY=sk-your-minimax-api-key

# Server-side only. Used for drink images, 16:9 first-frame outpainting and 5-second video generation.
# Never prefix this variable with VITE_ or expose it to browser code.
EVOLINK_API_KEY=sk-your-evolink-api-key

# Optional but recommended. Signs browser polling tokens and binds them to the verified user.
# Generate a random value, for example with: openssl rand -base64 32
VIDEO_TASK_SIGNING_SECRET=replace-with-a-long-random-secret

# Server-side only. Cloudflare R2 S3-compatible storage for generated media.
# Keep the access keys private. STORAGE_DOMAIN is optional and should not be
# used for access control when the bucket's r2.dev development URL is public.
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=your-r2-access-key-id
STORAGE_SECRET_KEY=your-r2-secret-access-key
STORAGE_BUCKET=your-private-bucket
STORAGE_DOMAIN=
