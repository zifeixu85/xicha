# Public browser endpoints — copy these from your Neon project console.
VITE_NEON_AUTH_URL=https://your-project.neonauth.region.aws.neon.tech/neondb/auth
VITE_NEON_DATA_API_URL=https://your-project.apirest.region.aws.neon.tech/neondb/rest/v1

# Server-side only. Used by `npm run db:migrate`; never expose this with VITE_.
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=require
